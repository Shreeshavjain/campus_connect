# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and must never be committed.

# MongoDB connection string (Atlas or local)
MONGODB_URI=

# Secret used to sign JWTs — use a long random string (32+ chars)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

NODE_ENV=development

# ── SMTP (password reset emails) ─────────────────────────────────────────────
# For development: use Gmail + App Password
# For production: use a transactional email provider (Resend, SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Campus Connect <noreply@campusconnect.app>"
